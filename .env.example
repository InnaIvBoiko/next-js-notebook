# =============================================================================
# Living Notebook — environment variables template
# -----------------------------------------------------------------------------
# 1. Copy this file to .env.local:  cp .env.example .env.local
# 2. Fill in the values below (or leave defaults for optional ones)
# 3. .env.local is gitignored — never commit real secrets
#
# Validation: every variable here is validated by zod at boot
# (see app/lessons/security-env/_lib/env.ts). If a required value is
# missing or malformed, `npm run dev` / `npm run build` will crash
# with the exact field name in the error message.
#
# 📚 See Lesson 18: /lessons/security-env for the full explanation.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — server-side secrets
# -----------------------------------------------------------------------------

# HMAC signing key for /api/webhook (Lesson 18).
# Minimum 16 characters. Used with crypto.timingSafeEqual.
# Generate:  openssl rand -hex 32
WEBHOOK_SECRET=replace-me-with-a-real-secret-min-16-chars

# Auth.js session encryption key.
# Minimum 32 characters. Rotating this invalidates all live sessions.
# Generate:  openssl rand -base64 32
# (Or:       npx auth secret — writes directly to .env.local)
AUTH_SECRET=replace-me-with-a-32-plus-character-secret


# -----------------------------------------------------------------------------
# OPTIONAL — GitHub OAuth provider (Lesson 14)
# -----------------------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/callback/github
#   Production callback URL:     https://<your-domain>/api/auth/callback/github
# If you skip these, GitHub sign-in is disabled but the rest of the app works
# (Credentials provider + every other lesson continues to function).

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


# -----------------------------------------------------------------------------
# OPTIONAL — public configuration
# -----------------------------------------------------------------------------
# ⚠️  Anything prefixed NEXT_PUBLIC_ is inlined into the BROWSER bundle.
# NEVER put a real secret here — it would be readable by any visitor.

# Site display name (used in headers + OG fallback).
NEXT_PUBLIC_SITE_NAME=Living Notebook

# Feature flag — flip to "true" to enable beta features (currently a no-op
# demo flag used by Lesson 18's env inspector).
NEXT_PUBLIC_FEATURE_BETA=false


# -----------------------------------------------------------------------------
# AUTO-SET BY THE PLATFORM (no need to fill in)
# -----------------------------------------------------------------------------
# These are populated by Vercel at runtime. Locally they're undefined.
#
#   NODE_ENV               'development' | 'production' | 'test'
#   VERCEL_ENV             'production' | 'preview' | 'development'
#   VERCEL_URL             auto-generated deployment hostname
#   VERCEL_REGION          e.g. 'fra1', 'iad1'
#   VERCEL_GIT_COMMIT_SHA  full commit hash of the deployed code
#   VERCEL_GIT_COMMIT_REF  branch name
#
# Lesson 20 (/deploy-ready) shows all of these live via /api/runtime-probe.
